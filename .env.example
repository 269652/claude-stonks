# =============================================================================
# LMTrade configuration — copy to .env and fill in.  Nothing here is committed.
# All values are optional: the bot runs in paper mode with synthetic data and a
# heuristic model if no keys are provided.
# =============================================================================

# ---- Trading mode -----------------------------------------------------------
# paper  = simulated broker (default, safe)
# live   = real Trade Republic execution via the unofficial pytr API (opt-in!)
LMTRADE_MODE=paper

# Starting budget in account currency (EUR for Trade Republic).
# Paper default is 100 so flat ~1 EUR fees don't dominate P&L.
LMTRADE_BUDGET=100

# Comma-separated instruments to watch (ISINs for TR, tickers for Yahoo Finance).
# Leave this UNSET/commented to use the full default universe from
# config/default.yaml (30 symbols: US mega-caps, EU blue chips, ETFs, crypto).
# Uncomment only if you want a smaller/custom list instead.
#LMTRADE_UNIVERSE=AAPL,MSFT,SPY

# ---- Model layer ------------------------------------------------------------
# Order the fusion engine consults providers. Any of:
#   heuristic  — deterministic financial-model vote, zero cost, always on
#   slm        — local SLM via Ollama (see OLLAMA_HOST below)
#   cloud      — Anthropic API (needs ANTHROPIC_API_KEY)
#   perplexity — Perplexity web research (needs PERPLEXITY_API_KEY)
#   claude_cli — locally-installed `claude` CLI (Claude Code) — no API key,
#                billed through your own Claude subscription/login, runs
#                entirely on this machine. Recommended for a fully local,
#                no-API-key setup instead of cloud/perplexity.
LMTRADE_MODEL_STACK=heuristic,slm,perplexity

# Local SLM via Ollama (optional)
OLLAMA_HOST=http://localhost:11434
LMTRADE_SLM_MODEL=qwen2.5:1.5b

# Cloud LLM (optional)
ANTHROPIC_API_KEY=
LMTRADE_CLOUD_MODEL=claude-haiku-4-5-20251001

# Perplexity research
PERPLEXITY_API_KEY=
LMTRADE_PERPLEXITY_MODEL=sonar

# Hourly news / daily strategy-review source: "perplexity" (default, needs
# PERPLEXITY_API_KEY) or "anthropic" (daily analysis default, needs
# ANTHROPIC_API_KEY) can each be swapped for "claude_cli" to use the local
# `claude` CLI instead — no API key, runs on this machine.
#LMTRADE_NEWS_PROVIDER=claude_cli
#LMTRADE_ANALYSIS_PROVIDER=claude_cli

# ---- Economics / self-sustaining loop ---------------------------------------
# Hourly cost of a rented GPU, if you use one (USD/hr; 0 when running locally).
# The bot halts new entries when its projected runway drops below the floor.
LMTRADE_GPU_USD_PER_HOUR=0.20
# Halt trading if (cash + equity - fees) falls below this many hours of runway
LMTRADE_MIN_RUNWAY_HOURS=6

# ---- Trade Republic (optional) ----------------------------------------------
# Trade Republic has no official API or API key — the unofficial adapters use
# your phone + app PIN (same credentials as the mobile app) via pytr. This is
# against TR's ToS; read docs/TRADE_REPUBLIC.md first. Two separate uses:
#  1. PAPER trading on real TR instruments: with credentials set (and
#     tr.use_derivatives on), the bot selects real TR knockout certificates
#     (real ISINs) for its simulated trades instead of synthetic options.
#     No orders are ever placed. First pairing needs interactive 2FA once —
#     run `pytr login -n "<TR_PHONE>" -p "<TR_PIN>" --store_credentials`
#     (the --store_credentials flag is required, or nothing is saved and the
#     bot can never resume the session; the phone number must match TR_PHONE
#     below character-for-character). TR's API is websocket-based and will
#     not work through websocket-blocking proxies.
#  2. LIVE execution (LMTRADE_MODE=live): stays behind the deliberate code
#     guard in brokers/trade_republic.py regardless of these credentials.
TR_PHONE=            # +49...
TR_PIN=              # 4-digit app PIN
TR_LOCALE=en

# ---- Web dashboard ----------------------------------------------------------
LMTRADE_WEB_HOST=0.0.0.0
LMTRADE_WEB_PORT=8000
